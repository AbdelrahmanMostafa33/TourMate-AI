*.ckpt

# AI experiment artifacts
mlruns/
.mlflow/
wandb/
outputs/
runs/
artifacts/

# Prompt/chain cache
.langchain/
langchain_cache/


# =============================================================================
# FASTAPI (Backend)
# =============================================================================

# SQLite databases
*.db
*.sqlite3
*.sqlite3-journal

# Alembic (keep versions/ folder, ignore autogenerated heads)
alembic/versions/*.pyc

# Uploaded files / media
uploads/
media/
static/uploads/

# Celery
celerybeat-schedule
celerybeat.pid

# Instance / runtime config
instance/

# Docs build
docs/_build/
/site

# PyBuilder
.pybuilder/
target/

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/


# =============================================================================
# FLUTTER (Mobile)
# =============================================================================

# Dart tooling
.dart_tool/
*.dart_tool/
.packages
.pub-cache/
.pub/

# Flutter generated
.flutter-plugins
.flutter-plugins-dependencies
lib/generated_plugin_registrant.dart

# Build outputs
build/

# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks
*.keystore

# iOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-to-trash
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/UserInterfaceState.xcuserstate
**/ios/.generated/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
Podfile.lock

# Web (Flutter Web)
lib/generated_plugin_registrant.dart

# Symbols
app.*.symbols

# Flutter exceptions (force-track these even if matched above)
!**/android/gradlew
!**/android/gradlew.bat
!**/android/gradle/wrapper/gradle-wrapper.jar
!**/android/gradle/wrapper/gradle-wrapper.properties

# Dart code generation (build_runner output)
*.g.dart
*.freezed.dart
*.mocks.dart
*.gen.dart


