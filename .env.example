# ═════════════════════════════════════════════════════════════════════════════
# 🌍 TourMate AI – Environment Configuration
# ═════════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in your actual values:
#   cp .env.example .env
#
# Required variables (the app will fail to start without these):
#   DATABASE_URL, SECRET_KEY
#
# AI API keys (the app will start but AI features will fail without these):
#   GOOGLE_API_KEY, GROQ_API_KEY
#
# Optional variables (sensible defaults provided):
#   REDIS_URL, FIREBASE_CREDENTIALS, BACKEND_BASE_URL, etc.
# ═════════════════════════════════════════════════════════════════════════════


# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver).
# Required — no default value.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tourmate


# ── Redis ────────────────────────────────────────────────────────────────────
# Session/persistence backend. Optional — defaults to localhost:6379.
REDIS_URL=redis://localhost:6379/0


# ── Firebase ─────────────────────────────────────────────────────────────────
# Path to your Firebase service account credentials file (relative to backend/).
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS=firebase-credentials.json


# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required — no default value.
SECRET_KEY=change-me-to-a-random-string


# ── AI — Gemini (required for itinerary planning & place embeddings) ────────
# Get a free API key from: https://aistudio.google.com/app/apikey
#
# Used by:
#   • Planner & Modifier agents → gemini-2.5-flash
#   • Embedding service        → gemini-embedding-2
#   • Vision/image analysis    → gemini-2.5-flash
#
# You can provide multiple comma-separated keys for automatic rotation:
#   GOOGLE_API_KEY=key1,key2,key3
GOOGLE_API_KEY=your_gemini_api_key_here


# ── AI — Groq (used for classification, extraction, validation, etc.) ───────
# Get a free API key from: https://console.groq.com
#
# Used by:
#   • Extractor, Router, Validator agents → llama-3.3-70b-versatile
#   • Preference reranker, Persona updater, Hotel selector
#
# You can provide multiple comma-separated keys for automatic rotation:
#   GROQ_API_KEY=key1,key2,key3
GROQ_API_KEY=gsk_your_groq_api_key_here


# ── Backend URL ──────────────────────────────────────────────────────────────
# Base URL for the backend API server (used by generated links).
BACKEND_BASE_URL=http://localhost:8000


# ── Stripe (Sandbox Payments) ────────────────────────────────────────────────
# These defaults are sandbox/test keys — safe to leave as-is for development.
# Replace with live keys for production.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...


# ── Amadeus (Flight Booking Simulation) ──────────────────────────────────────
# These defaults are test credentials — replace with your own for production.
# AMADEUS_CLIENT_ID=...
# AMADEUS_CLIENT_SECRET=...


# ── LangSmith (Observability / Tracing) ──────────────────────────────────────
# Optional. Set these to enable LLM call tracing via LangSmith.
# Get an API key at: https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls_...
# LANGCHAIN_PROJECT=tourmate-ai
