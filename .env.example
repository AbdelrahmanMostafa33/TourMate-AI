# === Database ===
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tourmate

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Firebase ===
# Path to your Firebase service account credentials file
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CREDENTIALS=firebase-credentials.json

# === Security ===
# Generate a random secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# === AI (Groq) ===
# Get a free API key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# === Backend ===
BACKEND_BASE_URL=http://localhost:8000
