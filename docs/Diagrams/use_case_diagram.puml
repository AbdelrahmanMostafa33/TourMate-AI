@startuml TourMate_Use_Case_Diagram
left to right direction
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

title TourMate AI — Use Case Diagram

' ═══════ ACTORS ═══════

actor "Traveler" as Traveler
actor "System Administrator" as Admin
actor "Stripe" as Stripe
actor "Amadeus" as Amadeus

' ═══════ SYSTEM BOUNDARY ═══════

rectangle "TourMate AI System" {

  ' ──── Account Management ────

  rectangle "Account Management" as Account {
    usecase "Register" as Reg
    usecase "Log In" as Login
    usecase "Manage Profile" as Profile
  }

  ' ──── Trip Planning ────

  rectangle "Trip Planning" as Planning {
    usecase "Chat with AI" as Chat
    usecase "Plan Trip" as Plan
    usecase "Modify Itinerary" as Modify
    usecase "View Trips" as ViewTrips
  }

  ' ──── Bookings & Payments ────

  rectangle "Bookings & Payments" as Booking {
    usecase "Book Flights" as BookFlights
    usecase "Book Hotels" as BookHotels
    usecase "Cancel Booking" as Cancel
    usecase "Manage Payments" as Pay
  }

  ' ──── Places & Media ────

  rectangle "Places & Media" as Places {
    usecase "Explore Places" as Explore
    usecase "Review Places" as Review
    usecase "Save Places" as Save
    usecase "Upload Images" as Upload
  }

  ' ──── Administration ────

  rectangle "Administration" as AdminGroup {
    usecase "Monitor System\nHealth" as Monitor
  }
}

' ═══════ TRAVELER CONNECTIONS ═══════

Traveler --> Reg
Traveler --> Login
Traveler --> Profile

Traveler --> Chat
Traveler --> Plan
Traveler --> ViewTrips

Traveler --> BookFlights
Traveler --> BookHotels
Traveler --> Cancel
Traveler --> Pay

Traveler --> Explore
Traveler --> Review
Traveler --> Save
Traveler --> Upload

' ═══════ ADMIN CONNECTIONS ═══════

Admin --> Monitor

' ═══════ RELATIONSHIPS ═══════

Modify .left.> Plan : <<extends>>
Upload .left.> Chat : <<extends>>

' ═══════ EXTERNAL SYSTEMS ═══════

Stripe <-- Pay
Amadeus <-- BookFlights

@enduml
