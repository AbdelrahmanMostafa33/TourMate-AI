@startuml Payment_Management_Flow
title Manage Payments (UC#7) — Stripe Sandbox & Simulated Fallback

actor Traveler
participant "Chat" as Chat
participant "Booking\\nService" as BkSvc
participant "Flight\\nService" as FltSvc
participant "Stripe\\nSandbox" as Stripe
participant "Stripe\\nWebhook" as WH

== Pay for a Single Booking (via Chat) ==

Traveler -> Chat: "Pay for my flight booking now"
activate Chat

Chat -> BkSvc: initiate_payment(booking_id, amount)
activate BkSvc

alt Stripe configured (sandbox mode)
  BkSvc -> Stripe: create_payment_intent(amount, currency)
  activate Stripe
  Stripe --> BkSvc: {client_secret, pi_id}
  deactivate Stripe
  BkSvc --> Chat: {client_secret, simulated: false}
  deactivate BkSvc

  Chat --> Traveler: "Secure checkout ready.\nComplete payment in the payment sheet."
  deactivate Chat

  Traveler -> Stripe: Complete Stripe Payment Sheet
  activate Stripe
  Stripe --> Traveler: {paymentIntent: succeeded}
  deactivate Stripe

  Traveler -> Chat: "Payment completed"
  activate Chat

  Chat -> BkSvc: confirm_after_payment(booking_id, pi_id)
  activate BkSvc
  BkSvc -> Stripe: verify_payment_intent(pi_id)
  activate Stripe
  Stripe --> BkSvc: {status: succeeded}
  deactivate Stripe

else Stripe unavailable (simulated fallback)
  BkSvc --> Chat: {client_secret: simulated, simulated: true}
  deactivate BkSvc
  Chat --> Traveler: "Payment simulated (test mode)."
  deactivate Chat

  Chat -> BkSvc: confirm_after_payment(booking_id, simulated_pi)
  activate BkSvc
  note right: No Stripe verification —\nassumed successful
end

alt Flight booking
  BkSvc -> FltSvc: confirm_flight_booking(priced_offer, traveler)
  activate FltSvc
  FltSvc -> Stripe: verify_payment_intent(pi_id)
  activate Stripe
  Stripe --> FltSvc: {status: succeeded}
  deactivate Stripe
  FltSvc -> FltSvc: Create Booking + Payment + Receipt
  FltSvc --> BkSvc: {booking: confirmed}
  deactivate FltSvc
else Hotel booking
  BkSvc -> BkSvc: confirm_booking(booking_id)
  note right: Simulated — no external\nhotel API called
end

BkSvc -> BkSvc: Update trip status to booking_confirmed\n(all bookings paid)
BkSvc --> Chat: {status: confirmed, receipt}
deactivate BkSvc

Chat --> Traveler: "Booking confirmed!\nReceipt: RCT-20260701-A1B2"
deactivate Chat

== Async Confirmation via Webhook ==

Stripe -> WH: POST /api/v1/webhooks/stripe\n{payment_intent.succeeded}
activate WH

WH -> BkSvc: handle_payment_succeeded(pi_id)
activate BkSvc
BkSvc -> BkSvc: Update Payment → completed\nConfirm Booking
BkSvc --> WH: {booking confirmed}
deactivate BkSvc

WH --> Stripe: 200 OK
deactivate WH

== Pay All Pending Bookings (via Chat) ==

Traveler -> Chat: "Pay for all my pending bookings"
activate Chat

Chat -> BkSvc: initiate_pay_all(trip_id)
activate BkSvc

alt Combined (flight + hotel)
  BkSvc -> Stripe: create_payment_intent(total_amount)
  activate Stripe
  Stripe --> BkSvc: {client_secret, pi_id}
  deactivate Stripe
else Individual per booking
  BkSvc -> Stripe: create_payment_intent(flight_amount)
  BkSvc -> Stripe: create_payment_intent(hotel_amount)
  activate Stripe
  Stripe --> BkSvc: {client_secrets[]}
  deactivate Stripe
end

BkSvc --> Chat: {payment_intents}
deactivate BkSvc

Chat --> Traveler: "All payments processed.\nTrip confirmed!"
deactivate Chat

== Payment Failure Recovery ==

Traveler -> Chat: "My payment failed, can I retry?"
activate Chat

Chat -> BkSvc: initiate_payment(booking_id, amount)
activate BkSvc
BkSvc --> Chat: {client_secret}
deactivate BkSvc

Chat --> Traveler: "Ready to retry. Opening checkout..."
deactivate Chat

@enduml
