@startuml TourMate AI — Architecture
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

title TourMate AI — Trip State, Profile & Agent Pipeline

' ── Legend ──────────────────────────────────────────────────────────────────

rectangle "Legend: reads <size:18>→</size> writes <size:18>←</size> reads & writes" as Legend #FFFFF0

' ── TripProfile ─────────────────────────────────────────────────────────────

rectangle "📋 TripProfile (Per-Trip)" as TripProfile #f3e5f5

' ── TripState ───────────────────────────────────────────────────────────────

rectangle "🧠 TripState (Central Workflow State)" as TripState #e1f5fe {

  rectangle "📥 Input" as Input
  rectangle "👤 Profile" as ProfileBox
  rectangle "📊 Pipeline Data" as PipelineBox
  rectangle "✅ Validation" as ValidationBox
  rectangle "🎮 Control Flow" as ControlBox
  rectangle "🔍 Meta / Debug" as MetaBox
}

' ── Pipeline Agents (6 nodes, no hotel selector) ────────────────────────────

rectangle "🤖 Pipeline Agents — LangGraph Graph (6 nodes)" as Agents #e8f5e9 {

  rectangle "1. Profile Loader\n───\n token, trip_id\n per-trip profile" as A1

  rectangle "2. Place Retriever\n───\n destination_city, profile\n filtered_places\n matched_interest_subcats" as A2

  rectangle "3. Candidate Scorer\n───\n filtered_places, profile\n candidate_places\n agent_messages" as A3

  rectangle "4. Planning Agent (Gemini 2.5 Flash)\n───\n candidate_places, profile\n draft_itinerary\n validation (retry)" as A4

  rectangle "5. Route Optimizer (OSRM + 2-opt)\n───\n draft_itinerary\n optimized_itinerary" as A5

  rectangle "6. Itinerary Validator (Groq Llama 3.3 70B)\n───\n optimized_itinerary, profile\n is_valid, validation" as A6
}

' ── Post-Approval (called from Orchestrator, not in graph) ─────────────────

rectangle "✅ Post-Approval (Orchestrator)" as PostApproval #fff8e1

' ── Edges ───────────────────────────────────────────────────────────────────

rectangle "🔁 LangGraph Edges" as Edges #f0f0f0

' ── External ────────────────────────────────────────────────────────────────

rectangle "🌐 External Services" as External {
  rectangle "Firebase Auth + Postgres (Profile DB)" as ES1
  rectangle "PostgreSQL Places DB" as ES2
  rectangle "OSRM Routing Server" as ES3
  rectangle "Gemini 2.5 Flash (planning, vision)\nGroq Llama 3.3 70B (router, val., reranker)" as ES4
}

rectangle "⛔ End" as END #f96

' ── Data flow: connections ─────────────────────────────────────────────────

' Profile → State
TripProfile -down- ProfileBox

' Pipeline execution order (6 nodes)
A1 -down-> A2
A2 -down-> A3
A3 -down-> A4
A4 -down-> A5
A5 -down-> A6

' Retry loop (validator → planner on failure)
A6 .down.> A4 : retry (up to 2 attempts)

' Post-approval flow
PostApproval -[hidden]- Agents

' Edge routing
A2 ..> Edges
Edges ..> A3 : filtered_places
Edges ..> END : empty
A3 ..> Edges
Edges ..> A4 : candidate_places
Edges ..> END : none
A4 ..> Edges
Edges ..> A5 : always
A5 ..> Edges
Edges ..> A6 : always
A6 ..> Edges
Edges ..> END : valid / exhausted
Edges ..> A4 : retries left

' External services
ES2 -right-> A2 : place data
ES3 -right-> A5 : routing
ES4 -right-> A4 : planning
ES4 -right-> A6 : validation
ES1 -right-> A1 : auth

' End node
END -[hidden]- A6

@enduml
