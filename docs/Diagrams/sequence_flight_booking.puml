@startuml Flight_Booking_Flow
title Flight Booking (UC#5) — Analysis View

actor Traveler
participant "Mobile App" as App
participant "Backend" as Backend
participant "Amadeus API" as Amadeus
participant "Database" as DB

== Search Flights ==

Traveler -> App: Request to book a flight
activate App

App -> Backend: Search flights\n{departure, destination, dates}
activate Backend

Backend -> Amadeus: Query available flight offers
activate Amadeus
Amadeus --> Backend: Available flights with pricing
deactivate Amadeus

Backend --> App: Flight options
deactivate Backend

App --> Traveler: Display available flights
deactivate App

== Select and Book Flight ==

Traveler -> App: Select a specific flight
activate App

App -> Backend: Book selected flight
activate Backend

Backend -> Amadeus: Confirm flight booking
activate Amadeus

alt Booking confirmed
  Amadeus --> Backend: Booking successful
  deactivate Amadeus

  Backend -> DB: Store booking record
  activate DB
  DB --> Backend: Booking saved
  deactivate DB

  Backend --> App: Booking confirmed with price
  deactivate Backend

  App --> Traveler: Flight booked, proceed\nto payment
  deactivate App

else Booking unavailable
  Amadeus --> Backend: Booking failed
  deactivate Amadeus

  Backend --> App: Booking failed
  deactivate Backend

  App --> Traveler: No longer available
  deactivate App
end

@enduml
