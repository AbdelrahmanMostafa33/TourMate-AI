@startuml Hotel_Booking_Flow
title Book Hotels (UC#6) — Simulated Booking via Chat

actor Traveler
participant "Chat" as Chat
participant "Booking\nService" as BkSvc

== AI Presents Hotel Options (in chat) ==

Traveler -> Chat: "I approve the itinerary.
What hotels do you recommend?"
activate Chat

Chat --> Traveler: "Here are hotel options...\n1. Hilton Cairo ($120/night)\n2. Marriott Downtown ($95/night)"

== Select Hotel & Book ==

Traveler -> Chat: "Book the Hilton Cairo, 2 nights"
activate Chat

Chat -> BkSvc: create_booking(trip_id, place_id, dates)
activate BkSvc

BkSvc -> BkSvc: Generate simulated confirmation
note right: No external hotel API called
Confirmation number & provider
details generated locally

BkSvc --> Chat: {booking_id, confirmation: "BK-A3F9C2"}
deactivate BkSvc

Chat --> Traveler: "Hilton Cairo booked!
Confirmation: BK-A3F9C2\nReady to proceed to payment?"
deactivate Chat

Traveler -> Chat: "Yes, proceed to payment"
activate Chat
Chat --> Traveler: "Opening secure checkout..."
note right: Payment handled in UC#7 — Manage Payments
deactivate Chat

== Book All Accommodations at Once ==

Traveler -> Chat: "Book all accommodations for my trip"
activate Chat

Chat -> BkSvc: create_bookings_for_all_stops(trip_id)
activate BkSvc

BkSvc -> BkSvc: Generate simulated confirmations
for each stop

BkSvc --> Chat: {bookings: [BK-A3F9C2, BK-B4G0D3]}
deactivate BkSvc

Chat --> Traveler: "All accommodations booked!
Trip moved to booking pending."
deactivate Chat

== Cancel a Booking (before payment) ==

Traveler -> Chat: "Cancel the Hilton booking"
activate Chat

Chat -> BkSvc: cancel_booking(booking_id)
activate BkSvc
BkSvc -> BkSvc: Mark booking as cancelled
BkSvc --> Chat: {status: cancelled}
deactivate BkSvc

Chat --> Traveler: "Hilton Cairo booking cancelled."
deactivate Chat

@enduml
