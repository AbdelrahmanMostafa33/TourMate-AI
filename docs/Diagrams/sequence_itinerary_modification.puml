@startuml Itinerary_Modification_Flow
title Itinerary Modification (UC#3) — Analysis View

actor Traveler
participant "Mobile App" as App
participant "Backend" as Backend
participant "AI Service" as AI
participant "Database" as DB

== Request Change ==

Traveler -> App: Request itinerary change
activate App

App -> Backend: Send modification request
activate Backend

Backend -> AI: Interpret modification intent
activate AI
AI --> Backend: Intent understood
deactivate AI

alt Preference adjustment
  Backend -> AI: Regenerate with updated preferences
  activate AI
  AI --> Backend: Revised itinerary
  deactivate AI

else Specific activity change
  Backend -> DB: Search for new places
  activate DB
  DB --> Backend: Matching places
  deactivate DB
  Backend -> AI: Select best replacement
  activate AI
  AI --> Backend: Selected place and position
  deactivate AI
  Backend -> Backend: Apply change to itinerary
end

Backend -> AI: Validate revised itinerary
activate AI
AI --> Backend: Itinerary validated
deactivate AI

Backend -> DB: Save updated itinerary
activate DB
DB --> Backend: Itinerary saved
deactivate DB

Backend --> App: Stream updated itinerary
deactivate Backend

App --> Traveler: Display revised itinerary
deactivate App

== Full Regeneration ==

Traveler -> App: Request completely new plan
activate App

App -> Backend: Regenerate trip
activate Backend

Backend -> AI: Generate new itinerary\nwith revised preferences
activate AI
AI --> Backend: Completely new itinerary
deactivate AI

Backend --> App: New itinerary response
deactivate Backend

App --> Traveler: Display new itinerary
deactivate App

@enduml
