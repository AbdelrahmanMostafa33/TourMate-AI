@startuml Itinerary_Modification_Flow
title AI Itinerary Modification (UC3 - nested)

actor Traveler
participant "WebSocket\nManager" as WS
participant "Orchestrator" as Orch
participant "Edit\nClassifier" as EC
participant "Preference\nReranker" as PR
participant "Itinerary\nModifier" as IM
participant "Validator" as Val
participant "LLM\nService" as LLM
participant "Place\nRetriever" as Ret

== Edit Request via WebSocket ==

Traveler -> WS: "Make this trip more cultural"
activate WS

WS -> Orch: edit_message(trip_id, "Make this trip more cultural")
activate Orch

Orch -> EC: classify_edit_type(payload)
activate EC

EC -> LLM: classify("Make this trip more cultural")
activate LLM
LLM --> EC: {edit_type: "preference_rerank", mode: 1}
deactivate LLM

EC --> Orch: {mode: 1, params: {preference: "cultural"}}
deactivate EC

== Mode 1: Preference Reranking (lightweight) ==

Orch -> PR: rerank_candidates(trip_id, "cultural")
activate PR

PR -> PR: boost_cultural_scores(candidates)
PR --> Orch: {reranked_places, new_order}
deactivate PR

== If Mode 2: Surgical Edit (ADD/REMOVE/SWAP) ==

' alt Mode 2 path

Orch -> IM: apply_delta_edit(trip_id, {action: "ADD", query: "museum"})
activate IM

IM -> Ret: retrieve_places("museum", city)
activate Ret
Ret --> IM: {candidates: [...]}
deactivate Ret

IM -> LLM: select_best_fit(candidates, current_itinerary)
activate LLM
LLM --> IM: {place_to_add, insert_position}
deactivate LLM

IM --> Orch: {modified_itinerary}
deactivate IM

' end alt

== Validate Changes ==

Orch -> Val: validate_itinerary(modified_itinerary)
activate Val

Val -> LLM: check_logical_flow, timing, feasibility
activate LLM
LLM --> Val: {valid: true, warnings: []}
deactivate LLM

Val --> Orch: {validated_itinerary}
deactivate Val

== Stream Result ==

Orch -> WS: stream_edit_response(chunks...)
activate Orch
WS --> Traveler: Updated itinerary text\ndiff highlights
deactivate Orch
deactivate WS

alt Mode 3: Full Pipeline Regeneration
  Orch -> Orch: re-run complete graph\npipeline with new prefs
end

@enduml
