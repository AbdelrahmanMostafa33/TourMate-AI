@startuml Chat_Message_Data_Flow
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title TourMate AI — Chat Message Data Flow
caption Flutter > WebSocket > Orchestrator > Redis > Streaming Response

' ═══════════════════════════════════════════════════════
' LAYER 1: Client
' ═══════════════════════════════════════════════════════

rectangle "Client" as ClientLayer #e3f2fd {
  rectangle "Flutter Mobile App" as Flutter
}

' ═══════════════════════════════════════════════════════
' LAYER 2: Entry
' ═══════════════════════════════════════════════════════

rectangle "Entry Layer" as EntryLayer #fff3e0 {
  rectangle "WebSocket Manager\n(app/ws/manager.py)" as WSManager
  rectangle "Chat Routes\n(app/api/v1/routes/chat.py)" as ChatRoutes
  rectangle "Firebase Auth\n(app/core/firebase.py)" as Firebase
}

' ═══════════════════════════════════════════════════════
' LAYER 3: Processing
' ═══════════════════════════════════════════════════════

rectangle "Processing Layer" as ProcessingLayer #e8f5e9 {

  rectangle "process_message_stream()\n1. Save msg to DB\n2. Send typing\n3. Load pool state\n4. Call handle_chat_stream()\n5. Stream tokens\n6. Execute actions\n7. Sync Redis to DB\n8. Persist images\n9. Commit" as ProcessStream

  rectangle "Orchestrator\n(ai_engine/conversation/)\n(orchestrator.py)\n\nhandle_chat_stream()\n_process_message()\n_process_message_inner()\n\nroutes: plan_trip\nmodify_itinerary\nsearch_flights\nselect_hotel\napprove_itinerary" as Orchestrator

  rectangle "Message Interpreter\n(ai_engine/conversation/)\n(message_interpreter.py)\n\ninterpret_message(state, text)\nRouterResult(action, extracted, response)\n\nUses LLM to classify intent\nUpdates conversation slots" as MsgInterp

  rectangle "Conversation State\n(ai_engine/conversation/))\n(conversation_state.py)\n\nPhases:\nGREETING > SLOT_FILLING\n> PLAN_GENERATION\n> ITINERARY_REVIEW\n> FLIGHT_SELECTION\n> HOTEL_SELECTION\n> BOOKING > COMPLETED\n\nSlots, history, itinerary\nto_dict() / from_dict()" as ConvState

  rectangle "Redis Session Manager\n(ai_engine/conversation/)\n(redis_memory.py)\n\nSessionManager\nsave() / load()\nresume_or_create()\nextend_ttl()\nget_active_session()\n\nTTL: configurable expiry" as RedisMgr
}

' ═══════════════════════════════════════════════════════
' LAYER 4: Pipeline
' ═══════════════════════════════════════════════════════

rectangle "Pipeline Layer" as PipelineLayer #f3e5f5 {

  rectangle "LangGraph Pipeline\n(ai_engine/graph/)\n\n6 Nodes:\nN1: load_profile\nN2: retrieval_agent\nN3: ranking_agent\nN4: planning_agent\nN5: optimization_agent\nN6: validator_agent\n\nEdges: conditional routing\nshould_rank / should_plan\nshould_optimize\nshould_validate\nshould_retry_or_end" as LangGraph

  rectangle "Planning Agent\n(ai_engine/agents/)\n(planning_agent.py)\n\nrun_planning_agent()\nLLM: Gemini 2.5 Flash" as PlanAgent

  rectangle "Hotel Agent\n(ai_engine/agents/)\n(hotel_agent.py)\n\nrun_hotel_selection()\nsimulated pool matching\nrule-based + LLM" as HotelAgent

  rectangle "Flight Selection\n(ai_engine/agents/)\n(flight_selection_agent.py)\n\nsearch_flights_for_trip()\nformat_flight_options()\nextract_flight_selection()\nAmadeus API" as FlightAgent

  rectangle "Itinerary Modifier\n(ai_engine/agents/)\n(itinerary_modifier_agent.py)\n\nrun_itinerary_modifier()\nsurgical ADD/REMOVE/SWAP\npreference re-rank\nfull pipeline regen" as Modifier

  rectangle "Scorer / Optimizer / Validator\nCandidateScorer\nRouteOptimizer\nItineraryValidator\nPoolManager" as OtherAgents
}

' ═══════════════════════════════════════════════════════
' LAYER 5: External / Infrastructure
' ═══════════════════════════════════════════════════════

rectangle "External / Infrastructure" as ExtLayer #fce4ec {

  rectangle "PostgreSQL DB\ntrips, itineraries, days, stops\nplaces, profiles, conversations\nmessages, reviews, bookings\nimages, feedback" as DB

  rectangle "LLM Services\nGemini 2.5 Flash: planning, vision, editing\nGroq Llama 3.3 70B: router, val., reranker" as LLM

  rectangle "External APIs\nAmadeus: flights (test env)\nOSRM: routing\nStripe: payments (sandbox)" as ExtAPI

  rectangle "LangSmith\n@traceable decorators\nAgent-level tracing" as LangSmith

  rectangle "Token Tracker\nPer-pipeline token counts\nAgent-level attribution" as TokenTracker
}

' ═══════════════════════════════════════════════════════
' DATA FLOW ARROWS (numbered steps)
' ═══════════════════════════════════════════════════════

' Step 1: Flutter opens WS
Flutter -down-> WSManager : "1 ws://host/ws/chat/(trip)?token=xxx"
Flutter -down-> ChatRoutes : "1 ws://host/ws/chat/new?token=xxx"

' Step 2: Auth
ChatRoutes -right-> Firebase : "2 verify_token(token)"
Firebase --> ChatRoutes : "2 uid or None"

' Step 3: Accept connection
ChatRoutes -right-> WSManager : "3 manager.connect(key, ws)"
WSManager --> Flutter : "3 WebSocket accepted"

' Step 4: Flutter sends message
Flutter -down-> ChatRoutes : "4 message + optional image"

' Step 5: Process message
ChatRoutes -down-> ProcessStream : "5 process_message_stream()"

' Step 6: Lock + Orchestrator
ProcessStream -right-> Orchestrator : "6 handle_chat_stream()"
ProcessStream -right-> DB : "6 save user message"

' Step 7: Orchestrator routing
Orchestrator -down-> MsgInterp : "7 interpret_message(state, text)"
MsgInterp --> Orchestrator : "7 action + extracted slots"

' Step 8: Redis load/save
Orchestrator -right-> RedisMgr : "8 resume_or_create(user_id, session_id)"
RedisMgr --> Orchestrator : "8 ConversationState"

' Step 9: Run pipeline
Orchestrator -down-> LangGraph : "9 run_pipeline(state)"

' Step 10: LangGraph pipeline agents (6 nodes in graph)
LangGraph -down-> PlanAgent : "10 planning_agent (Gemini)"
LangGraph -down-> OtherAgents : "10 scorer > optimizer > validator"

' Step 10b: Post-approval agents (from orchestrator, NOT LangGraph)
Orchestrator -down-> HotelAgent : "10b select hotels (after approval)"
Orchestrator -down-> FlightAgent : "10b search flights"
Orchestrator -down-> Modifier : "10b edit itinerary"

' Step 11: External calls
PlanAgent -down-> LLM : "11 generate itinerary"
HotelAgent -down-> DB : "11 Match hotels from pool"
FlightAgent -down-> ExtAPI : "11 Amadeus flights"
OtherAgents -down-> ExtAPI : "11 OSRM routing"

' Step 12: Results back
LangGraph --> Orchestrator : "12 optimized itinerary"
HotelAgent --> Orchestrator : "12b hotel suggestions"
FlightAgent --> Orchestrator : "12b flight offers"

' Step 13: Save session
Orchestrator -right-> RedisMgr : "13 manager.save(state)"
RedisMgr --> Orchestrator : "13 Redis updated"

' Step 14: Stream response
Orchestrator -up-> ProcessStream : "14 yield stream chunks"
ProcessStream -up-> WSManager : "15 manager.send(key, data)"
WSManager -up-> Flutter : "16 WebSocket send_json"

' Step 15: DB persistence
ProcessStream -right-> DB : "17 save itinerary, profile, messages"
ProcessStream -right-> DB : "17 sync Redis to DB"
ProcessStream -right-> DB : "17 persist image features"

' Step 16: LangSmith tracing
Orchestrator -right-> LangSmith : "traced() decorators"
PlanAgent -right-> LangSmith : "traced()"
HotelAgent -right-> LangSmith : "traced()"

' Token tracking
Orchestrator -right-> TokenTracker : "token_tracker.reset() + summary"

' Legend
rectangle "Flow Legend\n1-3 WebSocket connection & auth\n4-5 Message received\n6-8 Intent classification & state loading\n9-11 AI pipeline execution\n10b Post-approval agents\n12-13 Results collected & state saved\n14-16 Streaming response\n17 Final persistence to DB" as Legend #FFFFF0

@enduml
